=============== inplace_vector.nested begin ===============
cuda::std::inplace_vector<cuda::std::inplace_vector<int, 2>, 3> of size 2 = {
  [0] = cuda::std::inplace_vector<int, 2> of size 2 = {
    [0] = 13,
    [1] = -5
  },
  [1] = cuda::std::inplace_vector<int, 2> of size 1 = {
    [0] = 88
  }
}
=============== inplace_vector.nested end ===============
