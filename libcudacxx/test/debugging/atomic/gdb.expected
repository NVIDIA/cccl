  value = {
    first = 13,
    second = -5,
    third = 88
  }
}
=============== atomic.locked end ===============
=============== atomic.alias begin ===============
cuda::std::atomic<long long> = {
  value = -31
}
=============== atomic.alias end ===============
=============== atomic.nested begin ===============
cuda::std::array<cuda::std::atomic<int>, 2> = {
  [0] = cuda::std::atomic<int> = {
    value = 17
  },
  [1] = cuda::std::atomic<int> = {
    value = -64
  }
}
=============== atomic.nested end ===============
=============== atomic.reference begin ===============
