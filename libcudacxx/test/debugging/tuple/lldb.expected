=============== tuple.basic begin ===============
(cuda::std::tuple<int, double, char>) <address>: {
  [0] = 42
  [1] = 3.1400000000000001
  [2] = 'x'
}
=============== tuple.basic end ===============
=============== tuple.empty begin ===============
(cuda::std::tuple<>) <address> {}
=============== tuple.empty end ===============
