@PACKAGE_INIT@

if (NOT TARGET cuda-coop-tile::tile)
  set_and_check(_tile_include "@PACKAGE_CUDA_COOP_TILE_INSTALL_INCLUDE_DIR@")
  set(_tile_library "@PACKAGE_CUDA_COOP_TILE_INSTALL_LIBRARY_DIR@/cuda_coop_tile.tilelib")
  set(_tile_library_override FALSE)
  if (DEFINED ENV{CUDA_COOP_TILE_LIBRARY_PATH} AND NOT "$ENV{CUDA_COOP_TILE_LIBRARY_PATH}" STREQUAL "")
    file(REAL_PATH "$ENV{CUDA_COOP_TILE_LIBRARY_PATH}" _tile_library EXPAND_TILDE)
    set(_tile_library_override TRUE)
  endif()
  if (NOT EXISTS "${_tile_library}" OR IS_DIRECTORY "${_tile_library}")
    set(cuda-coop-tile_FOUND FALSE)
    set(cuda-coop-tile_NOT_FOUND_MESSAGE "Missing cuda-coop-tile library: ${_tile_library}")
    return()
  endif()
  foreach(_header cuda/coop/tile.cuh cccl/cuda/functional cccl/cuda/std/functional cccl/cub/version.cuh)
    if (NOT EXISTS "${_tile_include}/${_header}")
      set(cuda-coop-tile_FOUND FALSE)
      set(cuda-coop-tile_NOT_FOUND_MESSAGE "Missing cuda-coop-tile header: ${_tile_include}/${_header}")
      return()
    endif()
  endforeach()
  get_filename_component(_tile_library_dir "${_tile_library}" DIRECTORY)
  set(_tile_manifest "${_tile_library_dir}/provider-manifest.json")
  if (NOT EXISTS "${_tile_manifest}" AND NOT _tile_library_override)
    set(cuda-coop-tile_FOUND FALSE)
    set(cuda-coop-tile_NOT_FOUND_MESSAGE "Missing cuda-coop-tile identity manifest: ${_tile_manifest}")
    return()
  endif()
  if (EXISTS "${_tile_manifest}")
    file(READ "${_tile_manifest}" _tile_manifest_json)
    string(JSON _tile_abi ERROR_VARIABLE _tile_abi_error GET "${_tile_manifest_json}" cuda_coop_tile_abi)
    if (_tile_abi_error OR NOT _tile_abi STREQUAL "2")
      set(cuda-coop-tile_FOUND FALSE)
      set(cuda-coop-tile_NOT_FOUND_MESSAGE "TileLib interface ABI mismatch: expected 2. Install matching headers and TileLib.")
      return()
    endif()
    string(JSON _tile_sha256 ERROR_VARIABLE _tile_hash_error GET "${_tile_manifest_json}" tile_library sha256)
    file(SHA256 "${_tile_library}" _tile_actual_sha256)
    if (_tile_hash_error OR NOT _tile_sha256 STREQUAL _tile_actual_sha256)
      set(cuda-coop-tile_FOUND FALSE)
      set(cuda-coop-tile_NOT_FOUND_MESSAGE "TileLib does not match provider-manifest.json. Reinstall the TileLib and its manifest.")
      return()
    endif()
  endif()
  add_library(cuda-coop-tile::tile INTERFACE IMPORTED)
  set_property(TARGET cuda-coop-tile::tile PROPERTY CUDA_COOP_TILE_LIBRARY "${_tile_library}")
  target_include_directories(cuda-coop-tile::tile INTERFACE "${_tile_include}/cccl" "${_tile_include}")
  target_compile_features(cuda-coop-tile::tile INTERFACE cuda_std_20)
  target_compile_options(cuda-coop-tile::tile INTERFACE
    "$<$<COMPILE_LANGUAGE:CUDA>:--enable-tile>"
    "$<$<COMPILE_LANGUAGE:CUDA>:--tile-preview=simt>"
    "$<$<COMPILE_LANGUAGE:CUDA>:-Xtileiras=-l=\"${_tile_library}\">")
  if (WIN32)
    target_compile_options(cuda-coop-tile::tile INTERFACE "$<$<COMPILE_LANGUAGE:CUDA>:-Xcompiler=/Zc:preprocessor>")
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/cuda-coop-tile-link.cmake")
